# Django settings
# Generate a new key for a deployment you control.
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL — Session pooler supplied with the original BookEase project.
