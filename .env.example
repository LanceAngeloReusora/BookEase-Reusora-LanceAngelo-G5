# Django settings
SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL (recommended for IPv4-only local networks: Session pooler)
# Copy the exact host and username from Supabase Dashboard > Connect > Session pooler.
DB_NAME=postgres
DB_USER=postgres.<PROJECT-REF>
DB_PASSWORD=your-supabase-database-password
DB_HOST=your-session-pooler-host.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
